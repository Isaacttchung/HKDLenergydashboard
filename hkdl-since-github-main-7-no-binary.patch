+import assert from "node:assert/strict";
+import { existsSync, readFileSync } from "node:fs";
+import path from "node:path";
+import { test } from "node:test";
+import * as XLSX from "xlsx";
+import {
+  chhpRowKey,
+  parseChhpSheet,
+} from "@/lib/raw-to-master/parse-chhp-sheet";
+import { POWER_SOLAR_METER_MAPPINGS } from "@/lib/raw-to-master/power-solar-mappings";
+
+const FORMULA_FIXTURES = [
+  path.join(process.cwd(), "test/fixtures/Formula-DailyWeb4.xlsm"),
+  "/home/ubuntu/.cursor/projects/workspace/uploads/Formula_-_DailyWeb4_54f6.xlsm",
+];
+
+function resolveFormulaWorkbookPath(): string | null {
+  for (const candidate of FORMULA_FIXTURES) {
+    if (existsSync(candidate)) return candidate;
+  }
+  return null;
+}
+
+test("POWER_SOLAR_METER_MAPPINGS stays in sync with Formula-DailyWeb4 CHHP sheet", () => {
+  const workbookPath = resolveFormulaWorkbookPath();
+  if (!workbookPath) {
+    console.log("skip: Formula-DailyWeb4.xlsm not on disk");
+    return;
+  }
+
+  const workbook = XLSX.read(readFileSync(workbookPath), {
+    type: "buffer",
+    cellFormula: true,
+  });
+  const fromChhp = parseChhpSheet(workbook);
+  const chhpByKey = new Map(fromChhp.map((row) => [chhpRowKey(row), row]));
+  const codeByKey = new Map(
+    POWER_SOLAR_METER_MAPPINGS.map((row) => [chhpRowKey(row), row]),
+  );
+
+  assert.equal(
+    fromChhp.length,
+    POWER_SOLAR_METER_MAPPINGS.length,
+    "CHHP row count vs baked mappings",
+  );
+
+  for (const row of fromChhp) {
+    const key = chhpRowKey(row);
+    const baked = codeByKey.get(key);
+    assert.ok(baked, `missing baked mapping for CHHP row ${key}`);
+    assert.deepEqual(
+      baked.feedInTariffColumns,
+      row.feedInTariffColumns,
+      `feed-in columns for ${row.chhpMeterId}`,
+    );
+    assert.equal(
+      baked.rawColumnLetter,
+      row.rawColumnLetter,
+      `Mercury column for ${row.chhpMeterId}`,
+    );
+  }
+
+  for (const row of POWER_SOLAR_METER_MAPPINGS) {
+    assert.ok(chhpByKey.has(chhpRowKey(row)), `extra baked row ${row.chhpMeterId}`);
+  }
+});
diff --git a/disney-energy-gas-monitor/lib/raw-to-master/parse-chhp-sheet.ts b/disney-energy-gas-monitor/lib/raw-to-master/parse-chhp-sheet.ts
new file mode 100644
index 0000000..7395311
--- /dev/null
+++ b/disney-energy-gas-monitor/lib/raw-to-master/parse-chhp-sheet.ts
@@ -0,0 +1,114 @@
+import type { WorkBook } from "xlsx";
+import * as XLSX from "xlsx";
+import type {
+  MercuryRawLogicalId,
+  PowerSolarArea,
+  PowerSolarMeterMapping,
+} from "@/lib/raw-to-master/power-solar-mappings";
+
+const CHHP_SHEET = "CHHP";
+
+/** Formula-DailyWeb4 external link index on CHHP rows (not Top_10 RawData link ids). */
+const CHHP_LINK_TO_MERCURY: Record<number, MercuryRawLogicalId> = {
+  1: "Mercury_CCP",
+  3: "Mercury_HCCP",
+  4: "Mercury_Hotel",
+  5: "Mercury_Park",
+};
+
+export interface ParsedChhpRow {
+  area: PowerSolarArea;
+  chhpMeterId: string;
+  rawLogicalId: MercuryRawLogicalId;
+  rawColumnLetter: string;
+  feedInTariffColumns: string[];
+}
+
+function colLetterFromMercuryFormula(formula: string | undefined): string | null {
+  if (!formula) return null;
+  const match = formula.match(/Mercury_\w+!([A-Z]+):/);
+  return match ? match[1] : null;
+}
+
+function linkIndexFromMercuryFormula(formula: string | undefined): number | null {
+  if (!formula) return null;
+  const match = formula.match(/\[(\d+)\]/);
+  return match ? Number(match[1]) : null;
+}
+
+function parseFeedInList(cell: unknown): string[] {
+  return String(cell ?? "")
+    .split(/[,，]/)
+    .map((part) => part.trim())
+    .filter(Boolean);
+}
+
+function isAreaBannerRow(row: unknown[]): PowerSolarArea | null {
+  const label = String(row[0] ?? "").trim();
+  if (label === "1st") return null;
+  if (
+    (label === "CCP" ||
+      label === "HCCP" ||
+      label === "Hotel" ||
+      label === "Park") &&
+    String(row[1]).trim() === "1st"
+  ) {
+    return label;
+  }
+  return null;
+}
+
+/**
+ * Parse Formula-DailyWeb4 **CHHP** sheet: Mercury column + feed-in tariff letters.
+ * Master column headers are not on CHHP; merge with existing mappings when refreshing.
+ */
+export function parseChhpSheet(workbook: WorkBook): ParsedChhpRow[] {
+  const sheet = workbook.Sheets[CHHP_SHEET];
+  if (!sheet) {
+    throw new Error(`Formula workbook missing sheet "${CHHP_SHEET}"`);
+  }
+
+  const rows = XLSX.utils.sheet_to_json(sheet, {
+    header: 1,
+    defval: "",
+  }) as unknown[][];
+
+  let area: PowerSolarArea | null = null;
+  const parsed: ParsedChhpRow[] = [];
+
+  for (let rowIndex = 0; rowIndex < rows.length; rowIndex += 1) {
+    const row = rows[rowIndex];
+    const banner = isAreaBannerRow(row);
+    if (banner) {
+      area = banner;
+      continue;
+    }
+    if (!area) continue;
+
+    const chhpMeterId = String(row[0] ?? "").trim();
+    if (!chhpMeterId || chhpMeterId === "1st") continue;
+
+    const firstCell = sheet[XLSX.utils.encode_cell({ r: rowIndex, c: 1 })];
+    const formula = typeof firstCell?.f === "string" ? firstCell.f : undefined;
+    if (!formula) continue;
+
+    const link = linkIndexFromMercuryFormula(formula);
+    const rawLogicalId = link ? CHHP_LINK_TO_MERCURY[link] : undefined;
+    const rawColumnLetter = colLetterFromMercuryFormula(formula);
+    if (!rawLogicalId || !rawColumnLetter) continue;
+
+    parsed.push({
+      area,
+      chhpMeterId,
+      rawLogicalId,
+      rawColumnLetter,
+      feedInTariffColumns: parseFeedInList(row[9]),
+    });
+  }
+
+  return parsed;
+}
+
+export function chhpRowKey(row: ParsedChhpRow | PowerSolarMeterMapping): string {
+  return `${row.area}|${row.rawLogicalId}|${row.rawColumnLetter}|${row.chhpMeterId}`;
+}
diff --git a/disney-energy-gas-monitor/lib/upload/upload-token-session.ts b/disney-energy-gas-monitor/lib/upload/upload-token-session.ts
